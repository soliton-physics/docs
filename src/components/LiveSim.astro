---
interface Props {
  preset: string;
  height?: number;
}

const { preset, height = 440 } = Astro.props;
const playground = `${(import.meta.env.PUBLIC_PLAYGROUND_URL ?? 'https://soliton-playground.vercel.app').replace(/\/$/, '')}/`;
const src = `${playground}?preset=${preset}&embed`;
---

<figure class="live-sim">
  <iframe src={src} style={`height: ${height}px`} loading="lazy" title={`Live simulation: ${preset}`}></iframe>
  <figcaption>
    Running live in your browser. <a href={`${playground}?preset=${preset}`} target="_blank" rel="noopener">Open in the playground</a>
  </figcaption>
</figure>
