---
interface Props {
  preset?: string;
  scenario?: string;
  height?: number;
}

const { preset, scenario, height = 460 } = Astro.props;
const playground = `${(import.meta.env.PUBLIC_PLAYGROUND_URL ?? 'https://soliton-playground.vercel.app').replace(/\/$/, '')}/`;
const query = scenario ? `?mode=mechanics&scenario=${scenario}` : `?mode=waves&preset=${preset}`;
const src = `${playground}${query}&embed`;
const full = `${playground}${query}`;
const title = scenario ?? preset ?? 'simulation';
---

<figure class="live-sim">
  <iframe src={src} style={`height: ${height}px`} loading="lazy" title={`Live simulation: ${title}`}></iframe>
  <figcaption>
    <span>Live in your browser, computed by the engine.</span>
    <a href={full} target="_blank" rel="noopener">Open in the playground with sliders and graphs ↗</a>
  </figcaption>
</figure>
