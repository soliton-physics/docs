---
interface Props {
  preset?: string;
  scenario?: string;
  /** The scenario is one of the optics bench's, not a mechanics one. */
  optics?: boolean;
  /** The scenario is one of the thermal tab's. */
  thermal?: boolean;
  /** The scenario is one of the circuits tab's. */
  circuits?: boolean;
  height?: number;
  /** What stands under the frame; the default is for what the engine integrates. */
  caption?: string;
}

const { preset, scenario, optics = false, thermal = false, circuits = false, height = 460, caption = 'Live in your browser, computed by the engine.' } = Astro.props;
const playground = `${(import.meta.env.PUBLIC_PLAYGROUND_URL ?? 'https://soliton-playground.vercel.app').replace(/\/$/, '')}/`;
const query = scenario ? `?mode=${optics ? 'optics' : thermal ? 'thermal' : circuits ? 'circuits' : 'mechanics'}&scenario=${scenario}` : `?mode=waves&preset=${preset}`;
const src = `${playground}${query}&embed`;
const full = `${playground}${query}`;
const title = scenario ?? preset ?? 'simulation';
---

<figure class="live-sim">
  <iframe src={src} style={`height: ${height}px`} loading="lazy" title={`Live simulation: ${title}`}></iframe>
  <figcaption>
    <span>{caption}</span>
    <a href={full} target="_blank" rel="noopener">Open in the playground with sliders and graphs ↗</a>
  </figcaption>
</figure>

<script is:inline>
  // The simulation takes the theme of the page around it, and follows the reader's switch.
  (() => {
    const themed = (frame) => {
      const url = new URL(frame.src);
      const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      if (url.searchParams.get('theme') === theme) return;
      url.searchParams.set('theme', theme);
      frame.src = url.href;
    };
    const all = () => document.querySelectorAll('.live-sim iframe').forEach(themed);
    all();
    if (!window.liveSimThemed) {
      window.liveSimThemed = true;
      document.addEventListener('DOMContentLoaded', all);
      new MutationObserver(all).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    }
  })();
</script>
