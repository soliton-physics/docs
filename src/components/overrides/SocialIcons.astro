---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a class="play-link" href="https://solitonplay.com/play">Open playground <span aria-hidden="true">→</span></a>
<Default />

<style>
  .play-link {
    display: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    color: var(--sl-color-white);
    border: 1px solid transparent;
    background:
      linear-gradient(rgba(8, 12, 28, 0.95), rgba(8, 12, 28, 0.95)) padding-box,
      var(--soliton-gradient) border-box;
    transition: box-shadow 0.2s;
  }

  .play-link:hover {
    box-shadow: 0 0 24px -4px rgba(96, 165, 250, 0.6);
  }

  @media (min-width: 50rem) {
    .play-link {
      display: inline-flex;
    }
  }
</style>
