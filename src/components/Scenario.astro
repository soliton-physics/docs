---
import { Tabs, TabItem } from '@astrojs/starlight/components';
import LiveSim from './LiveSim.astro';

interface Props {
  id: string;
  height?: number;
  /** A scenario of the optics bench. */
  optics?: boolean;
}

const { id, height = 420, optics = false } = Astro.props;
---

<section class="scenario">
  <LiveSim
    scenario={id}
    optics={optics}
    height={height}
    caption={optics ? 'Live in your browser: every ray traced by the engine. Drag the knob.' : undefined}
  />
  <Tabs>
    <TabItem label="Intuition" icon="star">
      <slot name="intuition" />
    </TabItem>
    <TabItem label="The maths" icon="pencil">
      <slot name="maths" />
    </TabItem>
    <TabItem label="How the engine does it" icon="setting">
      <slot name="engine" />
    </TabItem>
  </Tabs>
</section>
