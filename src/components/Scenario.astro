---
import { Tabs, TabItem } from '@astrojs/starlight/components';
import LiveSim from './LiveSim.astro';

interface Props {
  id: string;
  height?: number;
  /** A scenario of the optics bench. */
  optics?: boolean;
  /** A scenario of the thermal tab. */
  thermal?: boolean;
  /** A scenario of the circuits tab. */
  circuits?: boolean;
  /** A scenario of the modern physics tab. */
  modern?: boolean;
  /** A scenario of the properties-of-matter tab. */
  matter?: boolean;
}

const { id, height = 420, optics = false, thermal = false, circuits = false, modern = false, matter = false } = Astro.props;
const caption = optics
  ? 'Live in your browser: every ray traced by the engine. Drag the knob.'
  : thermal
    ? 'Live in your browser: every molecule followed by the engine.'
    : circuits
      ? 'Live in your browser: solved by the engine from Kirchhoff’s laws. Press play to see the charges move.'
      : modern || matter
        ? 'Live in your browser, computed by the engine. Press play where there is something to watch.'
        : undefined;
---

<section class="scenario">
  <LiveSim
    scenario={id}
    optics={optics}
    thermal={thermal}
    circuits={circuits}
    modern={modern}
    matter={matter}
    height={height}
    caption={caption}
  />
  <Tabs>
    <TabItem label="Intuition" icon="star">
      <slot name="intuition" />
    </TabItem>
    <TabItem label="The maths" icon="pencil">
      <slot name="maths" />
    </TabItem>
    <TabItem label="How the engine does it" icon="setting">
      <slot name="engine" />
    </TabItem>
  </Tabs>
</section>
