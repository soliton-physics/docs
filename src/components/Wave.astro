---
import { Tabs, TabItem } from '@astrojs/starlight/components';
import LiveSim from './LiveSim.astro';

interface Props {
  id: string;
  height?: number;
}

const { id, height = 400 } = Astro.props;
---

<section class="scenario">
  <LiveSim preset={id} height={height} caption="Live in your browser, drawn from the formula itself." />
  <Tabs>
    <TabItem label="Intuition" icon="star">
      <slot name="intuition" />
    </TabItem>
    <TabItem label="The maths" icon="pencil">
      <slot name="maths" />
    </TabItem>
    <TabItem label="Try this" icon="rocket">
      <slot name="try" />
    </TabItem>
  </Tabs>
</section>
